---
import "../styles/global.css";
import { MESSAGES } from "../i18n";
import { localeBootScript } from "../i18n/boot";
import { LOCALES, OG_LOCALES, alternateLinks, localizePath, type Locale } from "../i18n/locale";
import { canonicalRedirect } from "../logic/canonical";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { title, description, socialTitle, ogAlt } = MESSAGES[locale].meta;
const site = Astro.site ?? Astro.url;
const url = new URL(localizePath("/", locale), site);
const alternates = alternateLinks("/", site.origin);
// One share card per language (public/og/nido-og-<locale>.png): crawlers read these tags, not JS.
const ogImage = new URL(`/og/nido-og-${locale}.png`, site);
const canonicalScript = `try{var t=(${canonicalRedirect})(location.href,${JSON.stringify(
  new URL(Astro.site ?? Astro.url).origin,
)});if(t)location.replace(t)}catch(e){}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <!-- First, before anything loads: move the default Firebase domains to the canonical one. -->
    <script is:inline set:html={canonicalScript} />
    <!-- Then send an unprefixed first visit to the saved or browser language (src/i18n/locale.ts). -->
    <script is:inline set:html={localeBootScript()} />
    <style is:inline>html[data-locale-pending] body{opacity:0}</style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1F2A35" />
    <link rel="canonical" href={url} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nido" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Light by default; dark only when chosen in the header (see src/logic/theme.ts).
      try {
        if (localStorage.getItem("nido-theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <noscript><p class="center">{MESSAGES[locale].meta.noscript}</p></noscript>
  </body>
</html>
