# TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api), not the v3 key.
TMDB_API_TOKEN=
# OMDb key for IMDb ratings (https://www.omdbapi.com/apikey.aspx, free tier ~1,000 calls/day).
OMDB_API_KEY=
# Gemini API key from AI Studio (free tier). Or set GOOGLE_GENAI_USE_VERTEXAI=1 + GOOGLE_CLOUD_PROJECT.
GOOGLE_API_KEY=

# Catalog regions whose streaming offers count, comma-separated (a VPN can add more).
NIDO_REGIONS=SE
NIDO_LANGUAGE=en-US
NIDO_MODEL=gemini-3.1-flash-lite
NIDO_MAX_LLM_CALLS=8
